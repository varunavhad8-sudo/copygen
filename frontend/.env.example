# ==========================================
# BACKEND ONLY — Never use VITE_ prefix for secrets
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==========================================

PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
REDIS_URL=rediss://default:<password>@<host>:<port>

FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@<project>.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-api03-...
GEMINI_API_KEY=AIzaSy...
SERPER_API_KEY=<serper-api-key>

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/google/callback

# Dodo Payments
DODO_API_KEY=<dodo-api-key>
DODO_WEBHOOK_SECRET=whsec_...
DODO_STARTER_PRODUCT_ID=pdt_...
DODO_GROWTH_PRODUCT_ID=pdt_...
DODO_AGENCY_PRODUCT_ID=pdt_...
DODO_STARTER_ANNUAL_PRODUCT_ID=pdt_...
DODO_GROWTH_ANNUAL_PRODUCT_ID=pdt_...
DODO_AGENCY_ANNUAL_PRODUCT_ID=pdt_...
DODO_DISCOUNT_CODE=<discount-code>
DODO_DISCOUNT_ID=dsc_...

# Cloudflare R2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret-key>
R2_BUCKET_NAME=<bucket-name>

# Razorpay (INR)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<strong-random-secret-min-32-chars>
RAZORPAY_STARTER_PLAN_ID=plan_...
RAZORPAY_GROWTH_PLAN_ID=plan_...
RAZORPAY_AGENCY_PLAN_ID=plan_...
RAZORPAY_STARTER_ANNUAL_PLAN_ID=plan_...
RAZORPAY_GROWTH_ANNUAL_PLAN_ID=plan_...
RAZORPAY_AGENCY_ANNUAL_PLAN_ID=plan_...

# Email (Resend)
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
EMAIL_FROM=YourApp <hello@yourdomain.com>

CLIENT_URL=https://yourdomain.com

# Admin — Use a strong, random 32+ char secret. Never share this.
ADMIN_SECRET=<generate-with: openssl rand -hex 32>

# Sentry (optional)
SENTRY_DSN=https://...@sentry.io/...

NODE_ENV=production

# ==========================================
# FRONTEND (Vite) — Only non-sensitive config
# These get bundled into the browser JS bundle — NO secrets here
# ==========================================
VITE_API_URL=https://api.yourdomain.com
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
VITE_FIREBASE_APP_ID=1:<number>:web:<hash>
VITE_APP_NAME=YourApp
WRITE_LOGS_TO_FILE=false

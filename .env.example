# Copy this file to .env for a self-hosted backend.
# Never commit the real .env file.

PORT=4000
NODE_ENV=development
LOCAL_MODE=true
MONGODB_URI=mongodb://127.0.0.1:27017/copygen
REDIS_URL=redis://127.0.0.1:6379

# Firebase Admin credentials
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Configure at least one provider for server-wide generation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Required when users store their own provider keys in Settings.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_KEYS_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Used by the existing payments/admin integrations when enabled.
ADMIN_SECRET=replace-me
CLIENT_URL=http://localhost:5173
